{
  "name": "litos-ui-vue",
  "description": "基于 Vue3 的 UI 组件库",
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "g:c": "node scripts/index.js template",
    "lib:build": "vite build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "inspect:eslint": "eslint --inspect-config"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@tanstack/vue-table": "^8.21.3",
    "@types/node": "^25.0.8",
    "@vitejs/plugin-vue": "^6.0.3",
    "less": "^4.5.1",
    "oxfmt": "^0.24.0",
    "oxlint": "^1.39.0",
    "ph-utils": "^0.16.5",
    "qrcode-generator-es": "^2.1.2",
    "shiki": "^3.21.0",
    "typescript": "^5.9.3",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "^7.3.1",
    "vitepress": "^1.6.4",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.2.2",
    "@iconify/vue": "^5.0.0"
  },
  "peerDependencies": {
    "@floating-ui/dom": "^1.7.4",
    "@tanstack/vue-table": "^8.21.3",
    "ph-utils": "^0.16.3",
    "qrcode-generator-es": "^2.0.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "files": [
    "lib",
    "style"
  ],
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    "./style/*": "./style/*",
    "./lib/*": "./lib/*",
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DvShu/litos-ui-vue.git"
  },
  "keywords": [
    "litos-ui-vue",
    "vue",
    "ui framework",
    "component library"
  ],
  "homepage": "https://dvshu.github.io/litos-ui-vue/",
  "bugs": {
    "url": "https://github.com/DvShu/litos-ui-vue/issues"
  },
